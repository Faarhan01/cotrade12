# Cotrade Configuration
# All settings have safe defaults and can be set via environment variables.

# Gateway Server
CONY_HOST="127.0.0.1"
CONY_PORT=8890
CONY_LOG_LEVEL="INFO"
# CONY_LOG_FILE="cotrade.log"

# Frontend Assets & Pages
CONY_FRONTEND_DIR="./frontend"

# Database Location
PERON_DB="./backend/data/peron.db"

# MetaTrader 5 Terminal Configuration (Optional)
# If MetaTrader5 is already open and logged in, credentials are not required.
# CONY_MT5_PACKAGE="C:\path\to\metatrader5_package"
# MT5_LOGIN=29974125
# MT5_PASSWORD="YourPasswordHere"
# MT5_SERVER="MetaQuotes-Demo"
# MT5_PATH="C:\Program Files\MetaTrader 5\terminal64.exe"
# MT5_TIMEOUT=60000

# Connection Lifecycle
CONY_AUTO_CONNECT=true
CONY_AUTO_RECONNECT=true
CONY_RECONNECT_INTERVAL=20
CONY_SYMBOL_CACHE_TTL=300
